# Copy to .env.backup; this file is loaded only by the backup container.
BACKUP_EXTERNAL_ENABLED=true
BACKUP_S3_BUCKET=your-private-backup-bucket
BACKUP_S3_REGION=us-east-1
# Optional S3-compatible endpoint, e.g. your provider's HTTPS endpoint.
BACKUP_S3_ENDPOINT_URL=
# Leave false; only enable for isolated local development object stores.
BACKUP_S3_ALLOW_INSECURE_ENDPOINT=false
BACKUP_S3_PREFIX=ai-trading-system
# Use AES256, aws:kms, or provider-managed if encryption at rest is automatic and documented.
BACKUP_S3_SERVER_SIDE_ENCRYPTION=AES256
BACKUP_S3_KMS_KEY_ID=
# Prefer workload identity/instance roles. If static keys are required, keep them here only.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_SESSION_TOKEN=
