DATABASE_PATH=data/trading.db
INITIAL_CASH_EUR=20
EXCHANGE_ID=kraken
# Comma-separated CCXT public market-data adapters; initial validation uses Kraken only.
MARKET_DATA_PROVIDER_IDS=kraken
# Optional free Twelve Data Basic API key; US equities/ETF market data only.
# Get a key at https://twelvedata.com/pricing (Basic plan: 800 API credits/day).
TWELVE_DATA_API_KEY=
# Keep a safety margin below the published 800 daily credits; endpoint weights may vary.
TWELVE_DATA_DAILY_CREDIT_BUDGET=750
TWELVE_DATA_MIN_REQUEST_INTERVAL_SECONDS=7.5
FEE_RATE=0.0026
SLIPPAGE_RATE=0.0005
MAX_ORDER_FRACTION=0.25
MAX_STOP_DISTANCE_FRACTION=0.05
MIN_ORDER_VALUE_EUR=1
MAX_DATA_AGE_SECONDS=60
MAX_FX_DATA_AGE_SECONDS=300
FX_CONVERSION_FEE_RATE=0.001
EQUITY_PAPER_FEE_RATE=0.001
EQUITY_PAPER_SLIPPAGE_RATE=0.001
MAX_EQUITY_ORDER_FRACTION=0.10
MAX_EQUITY_POSITION_FRACTION=0.20
MAX_EQUITY_STOP_DISTANCE_FRACTION=0.05
MIN_ORDER_VALUE_USD=1
MAX_EQUITY_SPREAD_FRACTION=0.02

# Optional Binance spot account read-only connector.
# Create an API key with READ permissions only; disable spot trading and withdrawals.
# These credentials are used only by the backend and are never returned by the API.
BINANCE_READONLY_API_KEY=
BINANCE_READONLY_API_SECRET=
# Optional generic CCXT CEX account connector (Spot balances only).
# Example: Kraken. Use API key permissions limited to reading balances.
CCXT_READONLY_EXCHANGE_ID=kraken
CCXT_READONLY_ACCOUNT_ALIAS=
CCXT_READONLY_API_KEY=
CCXT_READONLY_API_SECRET=

# Optional Alpaca Paper positions connector (read-only; disabled by default).
# Requires the exact Paper account ID from Alpaca; never use a live account ID.
# API key must be created with the minimum available read-only permissions.
ALPACA_PAPER_ENABLED=false
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
ALPACA_PAPER_ACCOUNT_ALIAS=alpaca-paper-readonly
ALPACA_PAPER_EXPECTED_ACCOUNT_ID=

# Binance Spot Demo Trading (virtual funds only); disabled unless explicitly enabled.
# Generate these separate credentials at demo.binance.com, never reuse production keys.
BINANCE_SPOT_DEMO_ENABLED=false
BINANCE_SPOT_DEMO_API_KEY=
BINANCE_SPOT_DEMO_API_SECRET=
# Hard per-order notional cap in the quote currency (default 25, maximum 1000).
BINANCE_SPOT_DEMO_MAX_ORDER_QUOTE=25
# Periodic Demo order/fill reconciliation continues even when strategy automation is paused.
BINANCE_DEMO_RECONCILIATION_INTERVAL_SECONDS=30

# Generate a long random secret before exposing the API; required for owner controls.
AGENT_CONTROL_TOKEN=replace-with-a-long-random-secret

# Worker schedules one paper decision cycle every 5 minutes while enabled.
DECISION_CYCLE_INTERVAL_SECONDS=300
# Autonomous read-only US equities/ETF research cadence (minimum 3600 seconds).
EQUITY_RESEARCH_INTERVAL_SECONDS=21600

# Daily SQLite backups in the persistent Docker volume; manual restore instructions in README.
BACKUP_INTERVAL_SECONDS=86400
# Retry failed or incomplete backup cycles without waiting a full day.
BACKUP_RETRY_INTERVAL_SECONDS=300
BACKUP_RETENTION_DAYS=14
BACKUP_DIRECTORY=/app/data/backups

# Off-host backups are configured only in .env.backup (loaded by the backup
# container, never by the API container). Keep this false in the shared .env.
BACKUP_EXTERNAL_ENABLED=false

# Optional public OHLCV history sync. The Compose service is also opt-in:
# docker compose --profile history-sync up -d history-sync
# Keep disabled until explicit EUR Spot targets have been selected.
HISTORICAL_DATA_SYNC_ENABLED=false
# Format: provider_id,symbol,timeframe;provider_id,symbol,timeframe
HISTORICAL_DATA_SYNC_TARGETS=
HISTORICAL_DATA_SYNC_INTERVAL_SECONDS=3600
HISTORICAL_DATA_SYNC_LOOKBACK_DAYS=365
HISTORICAL_DATA_SYNC_PAGE_LIMIT=500
HISTORICAL_DATA_SYNC_MAX_PAGES_PER_TARGET=10
