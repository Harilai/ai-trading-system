DATABASE_PATH=data/trading.db
INITIAL_CASH_EUR=20
EXCHANGE_ID=kraken
# Comma-separated CCXT public market-data adapters; initial validation uses Kraken only.
MARKET_DATA_PROVIDER_IDS=kraken
# Optional free Twelve Data Basic API key; US equities/ETF market data only.
# Get a key at https://twelvedata.com/pricing (Basic plan: 800 API credits/day).
TWELVE_DATA_API_KEY=
# Keep a safety margin below the published 800 daily credits; endpoint weights may vary.
TWELVE_DATA_DAILY_CREDIT_BUDGET=750
TWELVE_DATA_MIN_REQUEST_INTERVAL_SECONDS=7.5
FEE_RATE=0.0026
SLIPPAGE_RATE=0.0005
MAX_ORDER_FRACTION=0.25
MAX_STOP_DISTANCE_FRACTION=0.05
MIN_ORDER_VALUE_EUR=1
MAX_DATA_AGE_SECONDS=60

# Generate a long random secret before exposing the API; required for agent controls.
AGENT_CONTROL_TOKEN=replace-with-a-long-random-secret

# Worker schedules one paper decision cycle every 5 minutes while enabled.
DECISION_CYCLE_INTERVAL_SECONDS=300
# Autonomous read-only US equities/ETF research cadence (minimum 3600 seconds).
EQUITY_RESEARCH_INTERVAL_SECONDS=21600

# Daily SQLite backups in the persistent Docker volume; manual restore instructions in README.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_DIRECTORY=/app/data/backups
