DATABASE_PATH=data/trading.db
INITIAL_CASH_EUR=20
EXCHANGE_ID=kraken
# Comma-separated CCXT public market-data adapters; initial validation uses Kraken only.
MARKET_DATA_PROVIDER_IDS=kraken
FEE_RATE=0.0026
SLIPPAGE_RATE=0.0005
MAX_ORDER_FRACTION=0.25
MIN_ORDER_VALUE_EUR=1
MAX_DATA_AGE_SECONDS=60

# Generate a long random secret before exposing the API; required for agent controls.
AGENT_CONTROL_TOKEN=replace-with-a-long-random-secret

# Worker schedules one paper decision cycle every 5 minutes while enabled.
DECISION_CYCLE_INTERVAL_SECONDS=300
